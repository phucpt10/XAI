{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/plantxai-stability/protocol.schema.json",
  "title": "PlantXAI-Stability protocol draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "status", "frozen", "seed", "dataset", "models", "transformations", "xai", "statistics"],
  "properties": {
    "schema_version": {"type": "string"},
    "protocol_version": {"type": "string"},
    "status": {"enum": ["draft", "frozen", "retired"]},
    "frozen": {"type": "boolean"},
    "seed": {"type": "integer", "minimum": 0},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "configuration", "revision", "classes", "group_key", "official_test_policy"],
      "properties": {
        "source": {"type": "string"},
        "loader": {"enum": ["filesystem_csv", "huggingface_datasets"]},
        "configuration": {"type": "string"},
        "revision": {"type": "string", "minLength": 1},
        "classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "group_key": {"const": "leaf_id"},
        "official_test_policy": {"enum": ["preserve", "pending"]}
      }
    },
    "models": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "transformations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "severities", "parameters"],
      "properties": {
        "names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "severities": {"type": "array", "items": {"enum": ["mild", "moderate", "severe"]}},
        "parameters": {"type": "object"}
      }
    },
    "xai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "target_layers"],
      "properties": {
        "methods": {"type": "array", "items": {"type": "string"}},
        "target_layers": {"type": "object"}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_unit", "bootstrap_iterations", "confidence_level", "test", "correction"],
      "properties": {
        "bootstrap_unit": {"const": "leaf_id"},
        "bootstrap_iterations": {"type": "integer", "minimum": 100},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "test": {"const": "paired_wilcoxon"},
        "correction": {"const": "holm"}
      }
    }
  }
}
