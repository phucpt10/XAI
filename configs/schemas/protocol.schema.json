{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/plantxai-stability/protocol.schema.json",
  "title": "PlantXAI-Stability protocol draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "status", "frozen", "seed", "governance", "dataset", "models", "training", "transformations", "xai", "statistics"],
  "properties": {
    "schema_version": {"type": "string"},
    "protocol_version": {"type": "string"},
    "status": {"enum": ["draft", "frozen", "retired"]},
    "frozen": {"type": "boolean"},
    "frozen_at": {"type": ["string", "null"]},
    "protocol_hash": {"type": ["string", "null"]},
    "seed": {"type": "integer", "minimum": 0},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G0A_BOOTSTRAP_READY", "G0B_PROTOCOL_FREEZE_READY", "blockers", "G1_CHECKPOINT_SELECTION", "checkpoint_blockers", "G2_TEST_EVALUATION_READY", "test_evaluation_blockers", "evidence_records", "official_experiment_allowed", "official_training_allowed", "official_test_evaluation_allowed"],
      "properties": {
        "G0A_BOOTSTRAP_READY": {"enum": ["pass", "blocked"]},
        "G0B_PROTOCOL_FREEZE_READY": {"enum": ["pass", "blocked"]},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "G1_CHECKPOINT_SELECTION": {"enum": ["pass", "blocked"]},
        "checkpoint_blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "G2_TEST_EVALUATION_READY": {"enum": ["pass", "blocked"]},
        "test_evaluation_blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_records": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime_readiness", "xai_target_layers"],
          "properties": {
            "runtime_readiness": {"type": "string", "minLength": 1},
            "xai_target_layers": {"type": "string", "minLength": 1}
          }
        },
        "official_experiment_allowed": {"type": "boolean"},
        "official_training_allowed": {"type": "boolean"},
        "official_test_evaluation_allowed": {"type": "boolean"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "configuration", "revision", "classes", "group_key", "official_test_policy", "quarantine_policy"],
      "properties": {
        "source": {"type": "string"},
        "loader": {"enum": ["filesystem_csv", "huggingface_datasets"]},
        "configuration": {"type": "string"},
        "revision": {"type": "string", "minLength": 1},
        "classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "group_key": {"const": "leaf_id"},
        "official_test_policy": {"enum": ["preserve", "pending"]},
        "quarantine_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "decision_record", "official_test_action", "train_test_leaf_overlap_action"],
          "properties": {
            "enabled": {"const": true},
            "decision_record": {"type": "string"},
            "official_test_action": {"const": "preserve_exactly"},
            "train_test_leaf_overlap_action": {"const": "quarantine_source_train"}
          }
        },
        "image_size": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false},
        "rgb_range": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false},
        "imagenet_mean": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "imagenet_std": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "models": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pretrained", "pretrained_weights", "fine_tuning", "loss", "class_weighting", "max_epochs", "batch_size", "learning_rate", "optimizer", "weight_decay", "scheduler", "early_stopping_patience", "selection_metric", "mixed_precision", "deterministic_algorithms"],
      "properties": {
        "pretrained": {"type": "boolean"},
        "pretrained_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resnet50", "efficientnet_b0"],
          "properties": {
            "resnet50": {"const": "IMAGENET1K_V2"},
            "efficientnet_b0": {"const": "IMAGENET1K_V1"}
          }
        },
        "fine_tuning": {"const": "full_model"},
        "loss": {"const": "cross_entropy"},
        "class_weighting": {"const": "none"},
        "max_epochs": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "optimizer": {"type": "string"},
        "weight_decay": {"type": "number", "minimum": 0},
        "scheduler": {"type": "string"},
        "early_stopping_patience": {"type": "integer", "minimum": 1},
        "selection_metric": {"type": "string"},
        "mixed_precision": {"type": "boolean"},
        "deterministic_algorithms": {"const": true}
      }
    },
    "transformations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm_version", "names", "severities", "materialize_images", "deterministic_per_sample_seed", "record_exact_parameters", "parameters"],
      "properties": {
        "algorithm_version": {"const": "shared_randomization_v2"},
        "names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "severities": {"type": "array", "items": {"enum": ["mild", "moderate", "severe"]}},
        "materialize_images": {"type": "boolean"},
        "deterministic_per_sample_seed": {"type": "boolean"},
        "record_exact_parameters": {"type": "boolean"},
        "parameters": {"type": "object"}
      }
    },
    "xai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "target_layer_decision_record", "target_layers"],
      "properties": {
        "methods": {"type": "array", "items": {"type": "string"}},
        "target_layer_decision_record": {"type": "string"},
        "target_layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resnet50", "efficientnet_b0"],
          "properties": {
            "resnet50": {"type": "string", "minLength": 1},
            "efficientnet_b0": {"type": "string", "minLength": 1}
          }
        },
        "heatmap_epsilon": {"type": "number", "exclusiveMinimum": 0},
        "constant_heatmap_policy": {"type": "string"}
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_unit", "bootstrap_iterations", "confidence_level", "test", "correction"],
      "properties": {
        "bootstrap_unit": {"const": "leaf_id"},
        "bootstrap_iterations": {"type": "integer", "minimum": 100},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "test": {"const": "paired_wilcoxon"},
        "zero_method": {"type": "string"},
        "correction": {"const": "holm"},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "effect_size": {"type": "string"}
      }
    }
  }
}
